});

const ActionItem = styled(Box)({
  width: 90,
  display: "flex",
  flexDirection: "column",
  alignItems: "center",
  textAlign: "center",
  gap: 8,
});
const GroupNameTextField = styled(TextField)({
  "& .MuiOutlinedInput-root": {
    borderRadius: "8px",

    "& fieldset": {
      border: "1px solid #D8D9DB",
    },
