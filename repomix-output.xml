    background: "#F1F5F9",
  },
});

export default function ComposerToolbar({
  disabled,
  uploading,
  imageInputRef,
  fileInputRef,
  onImageChange,
  onFileChange,
}: ComposerToolbarProps) {
  return (
    <ToolbarRow data-testid="toolbar-input-chat">
      <StyledIconButton
        onClick={() => imageInputRef.current?.click()}
        disabled={disabled || uploading}
        aria-label="send-image"
