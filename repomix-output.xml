                                danger={item.danger}
                                onClick={() => {
                                    item.onClick?.();
                                    onClose();
                                }}
                            >
                                <MenuLeft>
                                    <MenuText>{item.label}</MenuText>
                                </MenuLeft>
                            </MenuRow>
                        </Box>
                    ))}
                </PopoverContent>
            )}
        </Popover>
    );
};

export default MenuPopover;
