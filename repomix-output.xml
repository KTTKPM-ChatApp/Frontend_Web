}));

export default function MessageActions({
  mine,
  canReply,
  canDelete,
  canForward,
  canPin,
  isPinned,
  onReply,
  onDelete,
  onForward,
  onTogglePin,
}: MessageActionsProps) {
  const t = useTrans();
  return (
    <ActionsWrap className="message-actions" mine={mine}>
      {canReply && (
        <Tooltip title={t("CHAT.ACTION_REPLY")}>
